# PRAKTIKUM 8 - METODE MAMDANI & 5 METODE DEFUZZIFIKASI
# ==========================================================
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

METODE = ["centroid", "bisector", "mom", "som", "lom"]
WARNA = {"centroid": "red", "bisector": "purple", "mom": "black", "som": "green", "lom": "orange"}

def bandingkan(agg, judul, file_png):
    hasil = {m: defuzz(U_HARGA, agg, m) for m in METODE}
    plt.figure(figsize=(12, 6.5))
    plt.plot(U_HARGA, agg, "b", lw=2.5, label="Kurva agregasi")
    plt.fill_between(U_HARGA, 0, agg, color="skyblue", alpha=0.4)
    for m, v in hasil.items():
        plt.axvline(v, color=WARNA[m], ls="--", lw=2, label=f"{m.upper()} ({rupiah(v)})")
    plt.title(judul, fontweight="bold"); plt.xlabel("Harga Jual (Rp)"); plt.ylabel("Derajat keanggotaan")
    plt.ylim(-0.05, 1.05); plt.grid(True, ls=":", alpha=0.6); plt.legend(loc="upper left", fontsize=9)
    plt.tight_layout(); plt.savefig(file_png, dpi=200); plt.close()
    return hasil

def cetak(hasil, judul):
    print("=" * 62); print(judul); print("=" * 62)
    for m, v in hasil.items():
        print(f" - Metode {m.upper():<9}: {rupiah(v):>10}")
    print()

if __name__ == "__main__":
    # --- Bagian 1: simulasi firing strength (seperti Tugas Praktikum 8) ---
    alpha = {"Murah": 0.5, "Sedang": 0.8, "Mahal": 0.2}
    agg = np.zeros_like(U_HARGA)
    for lbl, a in alpha.items():
        agg = np.fmax(agg, np.fmin(a, mf_eval(MF_HARGA[lbl], U_HARGA)))
    h1 = bandingkan(agg, "Defuzzifikasi Mamdani (a Murah=0.5, Sedang=0.8, Mahal=0.2)", "komparasi_defuzzifikasi_simulasi.png")
    cetak(h1, "SIMULASI: alpha Murah=0.5, Sedang=0.8, Mahal=0.2")

    # --- Bagian 2: kasus nyata dari input crisp (Biaya Rp75.000, Permintaan 60%) ---
    b, p = 75000, 60
    al, fb, fp = hitung_alpha(b, p)
    print(f"Kasus nyata: Biaya = {rupiah(b)}, Permintaan = {p}%")
    print("  Aturan aktif: " + ", ".join(f"{r[0]}({r[1]}/{r[2]}->{r[3]}, a={r[4]:.2f})" for r in al if r[4] > 0))
    agg2 = mamdani_agregasi(al)
    h2 = bandingkan(agg2, f"Defuzzifikasi Mamdani - Biaya {rupiah(b)}, Permintaan {p}%", "komparasi_defuzzifikasi_kasus_nyata.png")
    cetak(h2, "KASUS NYATA (Biaya Rp75.000, Permintaan 60%)")

    # --- Bagian 3: tabel perbandingan beberapa kasus ---
    print("TABEL PERBANDINGAN 5 METODE PADA BEBERAPA KASUS")
    print(f"{'Biaya':>10} {'Permintaan':>11} | " + " | ".join(f"{m.upper():>9}" for m in METODE) + " | Rugi?")
    for b, p in [(30000, 10), (75000, 60), (100000, 50), (130000, 80), (180000, 95)]:
        agg3 = mamdani_agregasi(hitung_alpha(b, p)[0])
        v = {m: defuzz(U_HARGA, agg3, m) for m in METODE}
        rugi = ",".join(m for m in METODE if v[m] < b) or "-"
        print(f"{b:>10} {p:>10}% | " + " | ".join(f"{v[m]:>9.0f}" for m in METODE) + f" | {rugi}")
