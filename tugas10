            Z[i, j] = evaluasi_sistem_fuzzy(X1[i, j], X2[i, j])
    fig = plt.figure(figsize=(10, 7)); ax = fig.add_subplot(111, projection="3d")
    surf = ax.plot_surface(X1 / 1000, X2, Z / 1000, cmap="viridis", edgecolor="none", alpha=0.92)
    ax.set_xlabel("Biaya Produksi (ribu Rp)"); ax.set_ylabel("Permintaan (%)"); ax.set_zlabel("Harga Jual (ribu Rp)")
    ax.set_title("Decision Surface: Penentuan Harga Jual Produk UMKM", fontweight="bold")
    fig.colorbar(surf, shrink=0.5, aspect=8); plt.tight_layout(); plt.savefig("decision_surface.png", dpi=200); plt.close()
    print(f"\nDecision surface: harga min = {rupiah(Z.min())}, harga maks = {rupiah(Z.max())}")

    # ---- 6. Uji sifat sistem (surface fuzzy murni): kemonotonan & kepatuhan terhadap biaya ----
    turun_b = -np.diff(Z, axis=1).clip(max=0).min()       # penurunan terbesar saat biaya naik
    turun_p = -np.diff(Z, axis=0).clip(max=0).min()       # penurunan terbesar saat permintaan naik
    print(f"Penurunan terbesar saat Biaya naik     : {rupiah(turun_b)} ({turun_b/200000*100:.2f}% dari domain)")
    print(f"Penurunan terbesar saat Permintaan naik: {rupiah(turun_p)} ({turun_p/200000*100:.2f}% dari domain)")
    print(f"Titik grid dengan harga fuzzy >= biaya        : {np.mean(Z >= X1)*100:.1f}%")
    Zf = np.vectorize(harga_aman)(Z, X1)
    print(f"Titik grid dengan harga final >= biaya (aman): {np.mean(Zf >= X1)*100:.1f}%  (untuk biaya > Rp181.818 harga dibatasi domain Rp200.000, margin < 10%)")
