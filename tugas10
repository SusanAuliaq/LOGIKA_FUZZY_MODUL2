# PRAKTIKUM 10 - ASESMEN MODUL 2: FUZZY DECISION SYSTEM
# SISTEM PENENTUAN HARGA JUAL PRODUK UMKM (MAMDANI + CENTROID)
# ==========================================================
import sys, csv
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D  # noqa: F401

def evaluasi_sistem_fuzzy(biaya, permintaan, metode="centroid"):
    biaya = min(max(biaya, 0), 200000)            # validasi domain
    permintaan = min(max(permintaan, 0), 100)
    return mamdani(biaya, permintaan, metode)

MARGIN_MIN = 0.10     # aturan pengaman bisnis: harga jual minimal = biaya + 10 %

def harga_aman(harga_fuzzy, biaya):
    """Pengaman: harga tidak boleh di bawah biaya + margin minimum, dan tidak melebihi domain Rp200.000."""
    return min(200000.0, max(harga_fuzzy, biaya * (1 + MARGIN_MIN)))

def kategori(harga):
    f = fuzzifikasi(harga, MF_HARGA)
    return max(f, key=f.get)

def rekomendasi(biaya, permintaan):
    al, fb, fp = hitung_alpha(biaya, permintaan)
    h_fuzzy = evaluasi_sistem_fuzzy(biaya, permintaan)
    harga = harga_aman(h_fuzzy, biaya)
    margin = (harga - biaya) / biaya * 100 if biaya > 0 else float("nan")
    return harga, kategori(harga), margin, [r for r in al if r[4] > 0], h_fuzzy

if __name__ == "__main__":
