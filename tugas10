    baris = []
    for i, (nama, b, p) in enumerate(skenario, 1):
        h, kat, mg, aktif, hf = rekomendasi(b, p)
        ra = ", ".join(f"{r[0]}({r[4]:.2f})" for r in aktif)
        mg_s = f"{mg:.1f}%" if b > 0 else "-"
        print(f"{i:<3}{nama:<30}{b:>9}{p:>6}%{rupiah(hf):>11}{rupiah(h):>11}{kat:>10}{mg_s:>9}  {ra}")
        baris.append([i, nama, b, p, round(hf), round(h), kat, mg_s, ra])
    with open("hasil_pengujian_asesmen2.csv", "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f); w.writerow(["No", "Skenario", "Biaya", "Permintaan", "Harga_Fuzzy", "Harga_Final", "Kategori", "Margin", "Aturan"]); w.writerows(baris)

    # ---- 3. Kurva agregasi satu kasus ----
    b, p = 90000, 85
    al, _, _ = hitung_alpha(b, p)
    agg = mamdani_agregasi(al); cen = defuzz(U_HARGA, agg)
    plt.figure(figsize=(11, 5.5))
    for lbl, spec in MF_HARGA.items():
        plt.plot(U_HARGA, mf_eval(spec, U_HARGA), "--", alpha=0.5, label=f"MF {lbl}")
    plt.fill_between(U_HARGA, 0, agg, color="purple", alpha=0.35, label="Agregasi"); plt.plot(U_HARGA, agg, "purple", lw=2.5)
    plt.axvline(cen, color="black", lw=2.5, label=f"Centroid = {rupiah(cen)}")
    plt.title(f"Kurva Agregasi Mamdani - Biaya {rupiah(b)}, Permintaan {p}%", fontweight="bold")
    plt.xlabel("Harga Jual (Rp)"); plt.ylabel("Derajat keanggotaan"); plt.legend(); plt.grid(True, ls=":", alpha=.6)
    plt.tight_layout(); plt.savefig("kurva_agregasi_asesmen2.png", dpi=200); plt.close()

    # ---- 4. Fungsi keanggotaan semua variabel ----
    fig, ax = plt.subplots(1, 3, figsize=(16, 4.2))
