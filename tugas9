    print(f"  mu Permintaan = { {k: round(v, 3) for k, v in fp.items()} }")
    t_val, t_z = tsukamoto(b, p)
    print(f"  {'Aturan':<6}{'Konsekuen':<10}{'alpha':>7}{'z Sugeno-0':>13}{'z Tsukamoto':>13}")
    for r, zt in zip(al, t_z):
