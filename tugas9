            print(f"  {r[0]:<6}{r[3]:<10}{r[4]:>7.3f}{KONSTANTA[r[3]]:>13}{zt:>13.0f}")
    print(f"  Sugeno orde 0 = {rupiah(sugeno0(b, p))} | Sugeno orde 1 = {rupiah(sugeno1(b, p))} | Tsukamoto = {rupiah(t_val)} | Mamdani = {rupiah(mamdani(b, p))}\n")

