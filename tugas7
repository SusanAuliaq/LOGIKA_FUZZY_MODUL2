import numpy as np

def trimf(x, p):
    a, b, c = p
    x = np.asarray(x, dtype=float)
    y = np.zeros_like(x)
    if b > a:
        m = (x > a) & (x < b); y[m] = (x[m] - a) / (b - a)
    if c > b:
        m = (x > b) & (x < c); y[m] = (c - x[m]) / (c - b)
    y[x == b] = 1.0
    return np.clip(y, 0.0, 1.0)

def trapmf(x, p):
    a, b, c, d = p
    x = np.asarray(x, dtype=float)
    y = np.zeros_like(x)
    if b > a:
        m = (x > a) & (x < b); y[m] = (x[m] - a) / (b - a)
    if d > c:
        m = (x > c) & (x < d); y[m] = (d - x[m]) / (d - c)
    y[(x >= b) & (x <= c)] = 1.0
    return np.clip(y, 0.0, 1.0)

U_BIAYA  = np.linspace(0, 200000, 2001)
U_PERMIN = np.linspace(0, 100, 1001)
U_HARGA  = np.linspace(0, 200000, 2001)

MF_BIAYA = {
    "Rendah": ("trap", [0, 0, 40000, 80000]),
    "Sedang": ("tri",  [60000, 100000, 140000]),
    "Tinggi": ("trap", [120000, 160000, 200000, 200000]),
}
MF_PERMIN = {
    "Rendah": ("trap", [0, 0, 20, 45]),
    "Sedang": ("tri",  [30, 50, 70]),
    "Tinggi": ("trap", [55, 80, 100, 100]),
}
MF_HARGA = {
    "Murah":  ("trap", [20000, 40000, 80000, 110000]),
    "Sedang": ("tri",  [80000, 120000, 160000]),
    "Mahal":  ("trap", [140000, 180000, 200000, 200000]),
}

def mf_eval(spec, x):
    tipe, p = spec
    return trimf(x, p) if tipe == "tri" else trapmf(x, p)

def fuzzifikasi(nilai, mf_dict):
    return {lbl: float(mf_eval(spec, np.array([nilai]))[0]) for lbl, spec in mf_dict.items()}

MATRIKS = {
    ("Rendah", "Rendah"): "Murah",  ("Rendah", "Sedang"): "Murah",  ("Rendah", "Tinggi"): "Sedang",
    ("Sedang", "Rendah"): "Sedang", ("Sedang", "Sedang"): "Sedang", ("Sedang", "Tinggi"): "Mahal",
    ("Tinggi", "Rendah"): "Mahal",  ("Tinggi", "Sedang"): "Mahal",  ("Tinggi", "Tinggi"): "Mahal",
}
RULES = [(f"R{i+1}", b, p, h) for i, ((b, p), h) in enumerate(MATRIKS.items())]

def hitung_alpha(biaya, permintaan):
    """Firing strength semua aturan (operator AND = min)."""
    fb = fuzzifikasi(biaya, MF_BIAYA)
    fp = fuzzifikasi(permintaan, MF_PERMIN)
    return [(rid, b, p, h, min(fb[b], fp[p])) for rid, b, p, h in RULES], fb, fp

def mamdani_agregasi(alphas):
    agg = np.zeros_like(U_HARGA)
    for _, _, _, h, a in alphas:
        agg = np.fmax(agg, np.fmin(a, mf_eval(MF_HARGA[h], U_HARGA)))
    return agg

def defuzz(x, mu, metode="centroid"):
    if mu.sum() == 0:
        return 0.0
    if metode == "centroid":
        return float(np.sum(x * mu) / np.sum(mu))
    if metode == "bisector":
        luas = np.concatenate([[0], np.cumsum((mu[1:] + mu[:-1]) / 2 * np.diff(x))])
        return float(np.interp(luas[-1] / 2, luas, x))
    mx = mu.max()
    M = x[np.isclose(mu, mx, atol=1e-9)]
    return float({"mom": M.mean(), "som": M.min(), "lom": M.max()}[metode])

def mamdani(biaya, permintaan, metode="centroid"):
    al, _, _ = hitung_alpha(biaya, permintaan)
    return defuzz(U_HARGA, mamdani_agregasi(al), metode)

def rupiah(v):
    return "Rp" + f"{v:,.0f}".replace(",", ".")

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

class FuzzyInferenceSystem:
    def __init__(self, implikasi="min"):
        self.inputs = {}
        self.output = None
        self.rules = []
        self.implikasi = implikasi        

    def add_input_variable(self, name, universe, mf_dict):
        self.inputs[name] = (np.asarray(universe), mf_dict)

    def set_output_variable(self, name, universe, mf_dict):
        self.output = (name, np.asarray(universe), mf_dict)

    def add_rule(self, rule_tuple):
        """rule_tuple = (label_input1, label_input2, ..., label_output)"""
        self.rules.append(rule_tuple)

    def fuzzify(self, input_values):
        return {n: fuzzifikasi(input_values[n], self.inputs[n][1]) for n in self.inputs}

    def evaluate_rules(self, fz):
        nama = list(self.inputs)
        hasil = []
        for r in self.rules:
            a = min(fz[n][l] for n, l in zip(nama, r[:-1]))
            hasil.append((r, a))
        return hasil

    def aggregate(self, hasil):
        _, z, mf = self.output
        agg = np.zeros_like(z)
        for r, a in hasil:
            kurva = mf_eval(mf[r[-1]], z)
            imp = np.fmin(a, kurva) if self.implikasi == "min" else a * kurva
            agg = np.fmax(agg, imp)
        return agg

    def compute(self, input_values, metode="centroid", detail=False):
        fz = self.fuzzify(input_values)
        hasil = self.evaluate_rules(fz)
        agg = self.aggregate(hasil)
        _, z, _ = self.output
        if agg.sum() == 0:                                 
            crisp = float((z[0] + z[-1]) / 2)
        else:
            crisp = defuzz(z, agg, metode)
        return (crisp, fz, hasil, agg) if detail else crisp

def bangun_fis(implikasi="min"):
    fis = FuzzyInferenceSystem(implikasi)
    fis.add_input_variable("biaya", U_BIAYA, MF_BIAYA)
    fis.add_input_variable("permintaan", U_PERMIN, MF_PERMIN)
    fis.set_output_variable("harga", U_HARGA, MF_HARGA)
    for _, b, p, h in RULES:
        fis.add_rule((b, p, h))
    return fis

if __name__ == "__main__":
    fis = bangun_fis()

    kasus = [
        ("Kasus 1", {"biaya": 30000,  "permintaan": 15}),
        ("Kasus 2", {"biaya": 100000, "permintaan": 50}),
        ("Kasus 3", {"biaya": 170000, "permintaan": 90}),
    ]
    print("=" * 78)
    print("HASIL PIPELINE FIS (Mamdani, implikasi MIN, defuzzifikasi Centroid)")
    print("=" * 78)
    for nama, inp in kasus:
        crisp, fz, hasil, agg = fis.compute(inp, detail=True)
        print(f"{nama}: Biaya = {rupiah(inp['biaya'])}, Permintaan = {inp['permintaan']}%")
        print(f"  Tahap 1 Fuzzifikasi  : biaya={ {k: round(v,2) for k,v in fz['biaya'].items()} }, "
              f"permintaan={ {k: round(v,2) for k,v in fz['permintaan'].items()} }")
        print("  Tahap 2 Aturan aktif : " + ", ".join(f"{b}/{p}->{h} (a={a:.2f})" for (b,p,h),a in hasil if a > 0))
        print(f"  Tahap 4 Output crisp : {rupiah(crisp)}\n")

    inp = {"biaya": 75000, "permintaan": 60}
    crisp, fz, hasil, agg = fis.compute(inp, detail=True)
