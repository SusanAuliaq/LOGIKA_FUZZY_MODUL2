    plt.title("Pipeline FIS: Implikasi, Agregasi, dan Defuzzifikasi Centroid\n"
              f"(Biaya {rupiah(inp['biaya'])}, Permintaan {inp['permintaan']}%)", fontweight="bold")
    plt.xlabel("Harga Jual (Rp)"); plt.ylabel("Derajat keanggotaan"); plt.ylim(-0.05, 1.05)
    plt.grid(True, ls=":", alpha=0.6); plt.legend(loc="upper left"); plt.tight_layout()
