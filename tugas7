    print(f"Contoh visualisasi (Biaya {rupiah(inp['biaya'])}, Permintaan 60%): output = {rupiah(crisp)}")

    print("\nPerbandingan implikasi Clipping (Min) vs Scaling (Product):")
    fis_prod = bangun_fis("prod")
    tambahan = [("Kasus 4", {"biaya": 75000, "permintaan": 60}),
                ("Kasus 5", {"biaya": 60000, "permintaan": 35}),
